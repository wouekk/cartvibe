{
  "name": "cartvibe",
  "version": "1.3.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config ./proxy.conf.json --host 0.0.0.0",
    "build": "ng build",
    "check:csp": "node tools/check-csp-hash.cjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:watch": "ng test --watch",
    "test:coverage": "ng test --configuration ci",
    "test:ci": "ng test --configuration ci",
    "i18n:extract": "node scripts/i18n/extract.mjs",
    "i18n:check": "node scripts/i18n/check.mjs",
    "i18n:sync": "node scripts/i18n/sync.mjs",
    "i18n:import": "node scripts/i18n/import-ts.mjs",
    "e2e": "playwright test",
    "e2e:ci": "playwright test --fail-on-flaky-tests",
    "e2e:smoke": "playwright test auth.spec dashboard-charts generate-password report-template-list",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "22.2.5",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/platform-browser-dynamic": "22.2.4",
    "@angular/router": "22.2.4",
    "@angular/service-worker": "22.2.4",
    "@fontsource-variable/geist": "5.3.0",
    "@ng-icons/core": "36.1.0",
    "@ng-icons/lucide": "36.1.0",
    "@ngxs/storage-plugin": "^22.0.0",
    "@ngxs/store": "^22.0.0",
    "@spartan-ng/brain": "1.9.0",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "chart.js": "4.5.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "^4.1.0",
    "jwt-decode": "^4.0.0",
    "ngx-mask": "22.2.5",
    "pretty-print-json": "^3.0.1",
    "rxjs": "~7.8.0",
    "tailwind-merge": "3.7.0",
    "tslib": "^2.3.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@angular/build": "~22.2.5",
    "@angular/cli": "~22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@angular/localize": "22.2.4",
    "@ngxs/devtools-plugin": "^22.0.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "postcss": "8.5.32",
    "tailwindcss": "4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.9",
    "undici": "^7.30.1",
    "vite": "~8.3.4"
  }
}
