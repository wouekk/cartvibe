  <script>
    // Scroll-driven showcase: the sticky stage reads how far the track has scrolled and shows one of four states.
    const track = document.querySelector<HTMLElement>('[data-testid="feature-track"]');
    const stage = document.querySelector<HTMLElement>('[data-testid="sticky-stage"]');
    const hero = document.querySelector<HTMLElement>('[data-testid="hero-visual"]');
    const steps = [...document.querySelectorAll<HTMLElement>("[data-step]")];
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    const clamp = (n: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, n));
    let active = -1;
    let ticking = false;

    function frame() {
      ticking = false;
      if (hero) hero.style.setProperty("--hero-p", String(0.4 + 0.6 * clamp(scrollY / 320, 0, 1)));
      if (!track || !stage || track.offsetParent === null) return;
      const range = track.offsetHeight - innerHeight;
      const progress = clamp(-track.getBoundingClientRect().top / Math.max(range, 1), 0, 1);
      const next = Math.min(3, Math.floor(progress * 4));
      if (next === active) return;
      active = next;
      stage.dataset.active = String(next);
      steps.forEach((el, i) => {
        if (i === next) el.setAttribute("aria-current", "step");
        else el.removeAttribute("aria-current");
      });
    }
    function request() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(frame);
      }
    }
    addEventListener("scroll", request, { passive: true });
    addEventListener("resize", request);
    request();

    // A step is a button: click or Enter/Space scrolls the track to the middle of that step's quarter.
    steps.forEach((el, i) => {
      el.querySelector("button")?.addEventListener("click", () => {
        if (!track) return;
        const range = track.offsetHeight - innerHeight;
        const top = track.getBoundingClientRect().top + scrollY + ((i + 0.5) / 4) * range;
        scrollTo({ top, behavior: reduce.matches ? "auto" : "smooth" });
      });
    });
  </script>
</Base>
