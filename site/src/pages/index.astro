---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import Shots from "../components/Shots.astro";
import Roadmap from "../components/Roadmap.astro";
import { socialImageUrl } from "../lib/social-image";

const repo = "https://github.com/wouekk/cartvibe";
// News about the iPhone app goes on its roadmap issue until there is an App Store page to link to.
const iphoneIssue = `${repo}/issues/1`;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
// The live demo of the real app, built from desktop/ and published beside this page (docs/site.md, "The demo").
const demo = `${base}/demo/`;

// The four steps of the scroll-driven track. `shot` names the demo screenshots in src/assets/shots (npm run shots).
const steps = [
  {
    icon: "cart",
    title: "Live household shopping lists",
    text: "Build the list on your phone, in the shop, one-handed. Add an item and it shows on every other phone in the family; cross things off as you go and mark the trip done. Made for a 360 px screen first.",
    shot: "shopping",
    alt: "A shared shopping list with amounts, health labels and a list of lists, on a desktop and a phone",
  },
  {
    icon: "scan",
    title: "Smart receipt line scanning",
    text: "Upload a photo or a PDF and the receipt's lines are read out one by one. Money is kept as exact decimals, never floats, so the lines add up to the cent and a mismatch is flagged instead of hidden.",
    shot: "receipts",
    alt: "The household's receipts with shop, amount and a status that flags a receipt to check, on a desktop and a phone",
  },
  {
    icon: "tag",
    title: "Optional AI labels",
    text: "With an AI key switched on, each line gets a category, a food-health rating (healthy, medium, unhealthy) and a planned or not-on-the-list flag. If the AI is offline, slow or out of credit, nothing fails: lines stay planned and unknown until a retry. The AI never assigns your tags.",
    shot: "lines",
    alt: "A receipt's product lines with category, health labels and a Not on the list flag, on a desktop and a phone",
  },
  {
    icon: "chart",
    title: "Household overview and monthly goals",
    text: "One Dashboard for groceries, eating out, transport, travel, leisure and bills, with a monthly goal you can watch fill up. Everyone in the family can add receipts, and Paid by is already the person signed in.",
    shot: "charts",
    alt: "Spending by category as a donut and spending by month as bars against a monthly goal, on a desktop and a phone",
  },
];

// More of the app, shown with real screenshots (demo data). `desktop` / `phone` name files in src/assets/shots.
const more = [
  {
    id: "warranties",
    icon: "shield",
    eyebrow: "Warranties",
    title: "Know what is still covered.",
    text: "Add a warranty date to any receipt and CartVibe lists everything still covered, nearest end first, with the days left. The Dashboard flags what ends soon.",
    points: ["The period defaults to your region and can be changed", "Optional push reminders before a warranty expires"],
    desktop: "warranties",
    phone: "warranties",
    alt: "A table of purchases under warranty with days left",
  },
  {
    id: "reports",
    icon: "file",
    eyebrow: "Reports",
    title: "Reports you can keep.",
    text: "Build a report once and generate it whenever you need it: by category, by shop or month by month. Reports come out as PDF, ready to print or file away.",
    points: ["Saved templates you can duplicate and edit", "A builder for scope, grouping and columns"],
    desktop: "reports",
    phone: "reports",
    alt: "A list of saved report templates",
  },
  {
    id: "barcode",
    icon: "barcode",
    eyebrow: "Barcode scanner",
    title: "Check a product in the aisle.",
    text: "Point the camera at a barcode, upload a photo of one or type the digits. CartVibe looks the product up in Open Food Facts and shows the Nutri-Score, the NOVA processing level, the additives and the nutrition.",
    points: ["Works from the phone camera in the browser", "Product data comes from Open Food Facts"],
    desktop: "check",
    phone: "check",
    alt: "The Check a product dialog with camera, upload and barcode number options",
  },
  {
    id: "app",
    icon: "phone",
    eyebrow: "On your phone",
    title: "Installs like an app, from your browser.",
    text: "CartVibe is a web app made for the phone in your hand at the shop. Add it to your home screen and it opens full screen, with the screen kept awake while you shop. Same account and data as the desktop.",
    points: ["Phone first, desktop second", "Day and night modes, plus accent palettes"],
    phone: "dashboard",
    alt: "The CartVibe Dashboard on a phone",
  },
];

const grid = [
  { icon: "store", title: "Shop logos", text: "Optional logos next to each shop, with your own free Logo.dev key." },
  { icon: "palette", title: "Day, night and palettes", text: "Light and dark modes with four accent palettes. Try the palette button above." },
  { icon: "globe", title: "Five languages", text: "English, Polish, German, French and Spanish." },
  { icon: "tag", title: "Your own tags", text: "Labels that are yours; the AI never invents tags." },
  { icon: "coins", title: "Foreign currencies", text: "Keep receipts in other currencies and convert at your own rates." },
  { icon: "users", title: "Family accounts", text: "Everyone can add things. Nobody splits bills." },
  { icon: "search", title: "Quick search", text: "Press Ctrl or Cmd K to search your receipts." },
  { icon: "bell", title: "Notifications", text: "Going shopping and warranty reminders, when you switch them on." },
  { icon: "refresh", title: "Live updates", text: "Shopping lists sync across devices without a refresh." },
];

const why = [
  {
    title: "No server needed on the iPhone",
    text: "CartVibe for iPhone, coming to the App Store, reads receipts on the phone itself and keeps your data on the iPhone or in your own iCloud. The family shares a household through iCloud. There is no account to create and no server of ours in between.",
  },
  {
    title: "Strictly private, zero ads",
    text: "No ads, no tracking cookies and no third-party scripts on this site. Self-hosted, your receipts, lists and photos stay on your own disk, and a backup is a copy of a folder. On the iPhone they stay on the phone or in your own iCloud. We run no server that holds your data.",
  },
  {
    title: "Open source and self-hostable (AGPL-3.0)",
    text: "CartVibe is free software under the AGPL-3.0 and a fork of Receipt Wrangler, with the credit kept in the licence files and on this page. No vendor lock-in: you can always run it on your own NAS, mini PC or VPS with SQLite and Docker.",
  },
];

const rows = [
  ["Your data stays on your own server", "yes", "Only if the file stays local", "Usually a vendor's cloud"],
  ["Reads receipt photos for you", "yes", "no", "Some do"],
  ["Keeps product lines, not just totals", "yes", "By hand", "Rarely"],
  ["Category and health labels per product", "yes", "By hand", "Rarely"],
  ["Shared shopping lists that sync live", "yes", "no", "Rarely"],
  ["Warranty tracking", "yes", "By hand", "Rarely"],
  ["Open source", "yes", "n/a", "Usually not"],
  ["Free to run yourself", "yes", "yes", "Varies"],
];

const faq = [
  { q: "What is CartVibe?", a: "A household app for receipts, shopping lists and spending insights. It is a family spending tracker, groceries first, and not business expense software." },
  { q: "Do I need to run a server?", a: "For the web app, yes: it is self-hosted. You need Docker with Docker Compose, or a NAS stack manager such as Synology's Container Manager. There is nothing to build: a ready-made image is published at ghcr.io/wouekk/cartvibe, and the quick start in the README has a short compose file. The iPhone app needs no server at all." },
  { q: "Does it need the AI?", a: "No. The AI is optional. Without it you add receipts and product lines by hand, and everything else works the same. With it, an admin adds a Claude, Gemini or ChatGPT key and Quick Scan reads receipts for you. If the provider is down or out of credit, CartVibe keeps going and retries later." },
  { q: "What does the AI get to see?", a: "Only when you turn it on, and only what you scan: the receipt photo or PDF goes to the provider whose key you configured. Nothing is sent to us, because there is no \"us\" server in the loop. The iPhone app reads receipts on the phone itself." },
  { q: "Where is my data stored?", a: "Self-hosted, on your server: a SQLite database and a folder of files. Back it up by copying the folder with the container stopped. In the iPhone app, on your iPhone, and in your own iCloud if you turn on sync." },
  { q: "Is it really free?", a: "Self-hosting is free and open source, under the AGPL-3.0, and stays that way. You pay for your own hardware or server, and for AI usage if you choose to use it. The iPhone app will be free to download, with an optional upgrade sold through the App Store." },
  { q: "Is there a mobile app?", a: "Two ways to have one. The web app installs from your phone's browser: add it to your home screen and it opens full screen like an app. And CartVibe for iPhone, a native app, is coming to the App Store." },
  { q: "Does the iPhone app connect to my server?", a: "No. CartVibe for iPhone is a separate app with its own data: it stays on your iPhone and, if you turn on sync, in your own iCloud, where we cannot read it. Your self-hosted server keeps its own data. The two share a name and a look, not a database." },
  { q: "How do I add AI API keys?", a: "You create a key on the provider's website (Claude, Gemini or ChatGPT), then sign in to CartVibe as an admin, open the AI page, choose the provider, paste the key, pick a model and press Test connection. The key is stored encrypted on your server. The cheapest small model is enough for receipts. The FAQ in the repository has the key pages and a model table." },
  { q: "How do I add a Logo.dev API key?", a: "Shop logos are optional. Create a free Logo.dev account and copy its secret key (it starts with sk_). In CartVibe, an admin opens System Settings, then Shop Logos, pastes the key, saves it and presses Download logos. Without a key each shop gets a letter instead." },
  { q: "How do I change a password?", a: "An admin sets it: Management, then Users, then the key icon on the person's row. There is no \"forgot password\" email, so the admin types a new password or generates one and hands it over. On a fresh install, change the default admin password straight away." },
  { q: "How do I rename a household?", a: "Open Management, then Households, press the pencil on the household's row, change its name and save. Its receipts, lists and members stay as they are." },
  { q: "Can the whole family use it?", a: "Yes. Accounts are either Admin or User, everyone in the household can add receipts and list items, and nobody has to split bills or approve anything." },
];

// Search and sharing (docs/site.md): the title (70 characters at most) and description (25-160, Bing's limits; written for
// people, as the snippet under the link), and one JSON-LD @graph that ties this site and the GitHub repository together
// as one piece of software. The FAQPage is built from `faq`, so it always matches the page.
const title = "CartVibe — Household Receipts, Shopping Lists & Spending Insights";
const description =
  "Scan receipts, share live shopping lists and see where your household's money goes. Free, open source (AGPL-3.0) and self-hosted. iPhone app coming soon.";
const home = new URL("/", Astro.site).href;
const agpl = "https://www.gnu.org/licenses/agpl-3.0.html";
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${home}#organization`,
      name: "CartVibe",
      url: home,
      logo: new URL("/brand/icon-light.svg", Astro.site).href,
      email: "support@cartvibe.app",
      sameAs: [repo],
    },
    {
      "@type": "WebSite",
      "@id": `${home}#website`,
      name: "CartVibe",
      url: home,
      inLanguage: "en",
      publisher: { "@id": `${home}#organization` },
    },
    {
      "@type": "SoftwareApplication",
      "@id": `${home}#app`,
      name: "CartVibe",
      url: home,
      description,
      image: await socialImageUrl(Astro.site),
      applicationCategory: "FinanceApplication",
      operatingSystem: "Web, Docker, Linux, iOS (coming soon)",
      license: agpl,
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      publisher: { "@id": `${home}#organization` },
      isBasedOn: { "@id": `${home}#source` },
      sameAs: [repo],
    },
    {
      "@type": "SoftwareSourceCode",
      "@id": `${home}#source`,
      name: "CartVibe",
      url: repo,
      codeRepository: repo,
      programmingLanguage: ["Go", "TypeScript"],
      runtimePlatform: "Docker",
      license: agpl,
      targetProduct: { "@id": `${home}#app` },
      publisher: { "@id": `${home}#organization` },
    },
    {
      "@type": "FAQPage",
      "@id": `${home}#faq`,
      mainEntity: faq.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ],
};

const btnPrimary ="inline-flex h-9 items-center justify-center gap-2 rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground transition-colors duration-150 hover:bg-primary/80 active:scale-[0.98]";
const btnOutline = "inline-flex h-9 items-center justify-center gap-2 rounded-md border border-border bg-background px-4 text-sm font-medium transition-colors duration-150 hover:bg-accent active:scale-[0.98]";
const tick = "mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-primary text-primary-foreground";
---

<Base title={title} description={description} jsonLd={jsonLd}>
  <!-- Hero -->
  <section data-testid="hero">
    <div class="page pb-16 pt-14 text-center sm:pt-20 lg:pb-24">
      <h1 class="mx-auto max-w-3xl text-balance text-4xl font-semibold tracking-tight sm:text-6xl">
        Your household's spending and shopping, finally in one place.
      </h1>
      <p class="mx-auto mt-4 max-w-xl text-[13px] text-muted-foreground sm:text-sm">
        Scan receipts at the shop, share live shopping lists, and see where the money goes. Made for your phone: run it free on your own server, or get CartVibe for iPhone, coming soon to the App Store.
      </p>
      <div class="hero-visual mx-auto mt-10 max-w-4xl text-left" data-testid="hero-visual">
        <Shots desktop="dashboard" phone="dashboard" eager class="max-w-4xl" sizes="(min-width: 1024px) 832px, 100vw" alt="The CartVibe Dashboard of the demo household: spent this month against a goal, spending by category and the open shopping list" />
      </div>
    </div>
  </section>

  <!-- Scroll-driven track, desktop -->
  <section id="features" class="relative hidden lg:block lg:min-h-[360vh]" data-testid="feature-track">
    <div class="sticky top-0 flex h-screen items-center pt-16" data-testid="sticky-stage" data-active="0">
      <div class="page grid grid-cols-12 items-center gap-10">
        <div class="col-span-5">
          <p class="cv-overline">How it works</p>
          <h2 class="mt-2 text-balance text-3xl font-semibold tracking-tight">Four things, one household.</h2>
          <ol class="mt-6 flex flex-col gap-2">
            {
              steps.map((s, i) => (
                <li
                  data-step={i}
                  class="rounded-xl border border-border/70 bg-card text-muted-foreground opacity-70 transition-[opacity,background-color,border-color] duration-200 hover:opacity-100 aria-[current=step]:border-primary aria-[current=step]:bg-accent/30 aria-[current=step]:text-foreground aria-[current=step]:opacity-100"
                  aria-current={i === 0 ? "step" : undefined}
                >
                  <button
                    type="button"
                    data-testid={`step-trigger-${i + 1}`}
                    class="flex w-full items-center gap-3 rounded-xl px-4 py-3 text-left"
                  >
                    <span class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-muted text-foreground">
                      <Icon name={s.icon} class="size-4" />
                    </span>
                    <span class="text-[15px] font-semibold text-foreground">{s.title}</span>
                  </button>
                  <div class="step-body">
                    <div>
                      <p class="px-4 pb-4 text-[13px] leading-relaxed">{s.text}</p>
                    </div>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>
        <div class="relative col-span-7 h-[min(34rem,68vh)]">
          {
            steps.map((s, i) => (
              <div class="state-layer absolute inset-0" data-state={i}>
                <div class="flex h-full items-center">
                  <Shots desktop={s.shot} phone={s.shot} alt={s.alt} />
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- The same four steps, stacked, below lg -->
  <section id="features-stacked" class="page py-16 lg:hidden" data-testid="feature-stack">
    <p class="cv-overline">How it works</p>
    <h2 class="mt-2 text-balance text-2xl font-semibold tracking-tight">Four things, one household.</h2>
    <div class="mt-8 flex flex-col gap-6">
      {
        steps.map((s, i) => (
          <article class="flex flex-col gap-6 rounded-xl border border-border/70 bg-card p-4">
            <div>
              <span class="flex size-8 items-center justify-center rounded-lg bg-muted">
                <Icon name={s.icon} class="size-4" />
              </span>
              <h3 class="mt-3 text-lg font-semibold">{s.title}</h3>
              <p class="mt-2 text-[13px] leading-relaxed text-muted-foreground">{s.text}</p>
            </div>
            <Shots desktop={s.shot} phone={s.shot} alt={s.alt} />
          </article>
        ))
      }
    </div>
  </section>

  <!-- More of the app: real screenshots -->
  <section>
    <div class="page py-20">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-balance text-3xl font-semibold tracking-tight">Built for everything beyond the weekly shop</h2>
      </div>
      <div class="mt-14 space-y-20">
        {
          more.map((s, i) => (
            <article id={s.id} class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
              <div class:list={[i % 2 === 1 && "lg:order-2"]}>
                <span class="flex size-9 items-center justify-center rounded-lg bg-primary text-primary-foreground">
                  <Icon name={s.icon} class="size-4" />
                </span>
                <p class="cv-overline mt-4">{s.eyebrow}</p>
                <h3 class="mt-1 text-2xl font-semibold tracking-tight">{s.title}</h3>
                <p class="mt-3 text-sm text-muted-foreground">{s.text}</p>
                <ul class="mt-5 space-y-2 text-sm">
                  {s.points.map((p) => (
                    <li class="flex gap-3">
                      <span class={tick}><Icon name="check" class="size-3" /></span>
                      <span>{p}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <Shots desktop={s.desktop} phone={s.phone} alt={s.alt} />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Smaller features -->
  <section class="page py-20">
    <h2 class="text-balance text-center text-3xl font-semibold tracking-tight">The small things</h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-sm text-muted-foreground">Details you notice after a week of using it.</p>
    <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        grid.map((m) => (
          <li class="rounded-xl border border-border/70 bg-card p-4">
            <span class="flex size-9 items-center justify-center rounded-lg bg-muted"><Icon name={m.icon} class="size-4" /></span>
            <h3 class="mt-3 text-[15px] font-semibold">{m.title}</h3>
            <p class="mt-1 text-[13px] text-muted-foreground">{m.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Why -->
  <section id="why">
    <div class="page py-20">
      <h2 class="text-balance text-center text-3xl font-semibold tracking-tight">Private by design. On your server or your iPhone.</h2>
      <ol class="mt-12 grid gap-4 lg:grid-cols-3">
        {
          why.map((w, i) => (
            <li class="rounded-xl border border-border/70 bg-card p-6">
              <span class="flex size-8 items-center justify-center rounded-full bg-primary text-sm font-semibold tabular-nums text-primary-foreground">{i + 1}</span>
              <h3 class="mt-5 text-lg font-semibold">{w.title}</h3>
              <p class="mt-2 text-sm text-muted-foreground">{w.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Comparison -->
  <section class="page max-w-5xl py-20">
    <h2 class="text-balance text-center text-3xl font-semibold tracking-tight">How it compares</h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-sm text-muted-foreground">CartVibe next to a spreadsheet and a typical expense app.</p>
    <div class="mt-10 overflow-x-auto rounded-xl border border-border/70 bg-card" tabindex="0" role="region" aria-label="Comparison table, scrolls sideways on narrow screens">
      <table class="w-full min-w-[40rem] border-collapse text-left text-sm">
        <caption class="sr-only">Comparison of CartVibe, spreadsheets and generic expense apps</caption>
        <thead>
          <tr class="border-b border-border/60">
            <th scope="col" class="cv-overline p-4">Feature</th>
            <th scope="col" class="cv-overline p-4 !text-primary">CartVibe</th>
            <th scope="col" class="cv-overline p-4">Spreadsheet</th>
            <th scope="col" class="cv-overline p-4">Generic expense app</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((r) => (
              <tr class="border-b border-border/40 last:border-0">
                <th scope="row" class="p-4 font-medium">{r[0]}</th>
                {r.slice(1).map((cell, ci) => (
                  <td class="p-4">
                    {cell === "yes" ? (
                      <span class="flex size-5 items-center justify-center rounded-full bg-primary text-primary-foreground">
                        <Icon name="check" class="size-3" />
                        <span class="sr-only">Yes</span>
                      </span>
                    ) : cell === "no" ? (
                      <span class="inline-flex items-center gap-1.5 text-muted-foreground">
                        <Icon name="dash" class="size-4" /> No
                      </span>
                    ) : (
                      <span class:list={[ci > 0 || cell === "n/a" ? "text-muted-foreground" : ""]}>{cell}</span>
                    )}
                  </td>
                ))}
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-[13px] text-muted-foreground">
      Expense apps differ a lot; the last column is a general picture, not a claim about any one product.
    </p>
  </section>

  <!-- Two ways to use it: self-hosted, or the iPhone app -->
  <section id="iphone">
    <div class="page max-w-5xl py-20">
      <h2 class="text-balance text-center text-3xl font-semibold tracking-tight">Two ways to use CartVibe</h2>
      <p class="mx-auto mt-3 max-w-2xl text-center text-sm text-muted-foreground">Run the open-source web app on your own server, or use the iPhone app. Neither one sends your data to us.</p>
      <div class="mt-10 grid gap-4 md:grid-cols-2">
        <div class="flex flex-col rounded-xl border border-primary bg-card p-6 ring-1 ring-primary/20">
          <h3 class="text-lg font-semibold">Self-hosted</h3>
          <p class="cv-overline mt-1 !text-green-700 dark:!text-success-text">Available today</p>
          <p class="mt-2 text-4xl font-semibold tracking-tight">Free forever</p>
          <p class="mt-2 text-sm text-muted-foreground">Open source, on your own server: a NAS, a mini PC or a VPS.</p>
          <ul class="mt-6 flex-1 space-y-3 text-sm">
            {
              ["All the features on this page", "Your data on your own disk", "Free software, AGPL-3.0", "Your own AI key, only if you want the AI"].map((p) => (
                <li class="flex gap-3">
                  <span class={tick}><Icon name="check" class="size-3" /></span>
                  <span>{p}</span>
                </li>
              ))
            }
          </ul>
          <a href={`${repo}#quick-start`} class={`${btnPrimary} mt-8`}>Read the quick start</a>
        </div>
        <div class="flex flex-col rounded-xl border border-border/70 bg-card p-6" data-testid="iphone-card">
          <div class="flex items-center gap-3">
            <h3 class="text-lg font-semibold">CartVibe for iPhone</h3>
            <span class="rounded-full border border-border/70 bg-muted px-2.5 py-0.5 text-[11px] font-medium text-foreground/70">Coming soon</span>
          </div>
          <p class="mt-2 text-4xl font-semibold tracking-tight">Free to start</p>
          <p class="mt-2 text-sm text-muted-foreground">A native app for the shop: scan a receipt or tick off the list, even offline. No server to run.</p>
          <ul class="mt-6 space-y-3 text-sm">
            {
              ["Receipts read on the phone itself", "Your data on your iPhone, or in your own iCloud", "Share a household with the family through iCloud", "No account to create; an optional upgrade through the App Store"].map((p) => (
                <li class="flex gap-3">
                  <span class={tick}><Icon name="check" class="size-3" /></span>
                  <span>{p}</span>
