---
// The roadmap lives on the home page now; an old /roadmap/ link lands on it.
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const target = `${base}/#roadmap`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Roadmap · CartVibe</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body>
    <p><a href={target}>The roadmap is on the home page.</a></p>
  </body>
</html>
