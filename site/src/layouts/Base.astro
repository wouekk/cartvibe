---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import Footer from "../components/Footer.astro";
import Wordmark from "../components/Wordmark.astro";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const repo = "https://github.com/wouekk/cartvibe";
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const nav = [
  { href: `${base}/demo/`, label: "Try the demo" },
  { href: `${base}/#features`, label: "Features" },
  { href: `${base}/#why`, label: "Why CartVibe" },
  { href: `${base}/#cloud`, label: "Cloud plan" },
  { href: `${base}/roadmap/`, label: "Roadmap" },
  { href: `${base}/#faq`, label: "FAQ" },
];
// Same keys and order as PALETTES in desktop/src/theme/themes.ts.
const palettes = [
  { key: "blue", label: "Blue" },
  { key: "zinc", label: "Zinc" },
  { key: "indigo", label: "Indigo" },
  { key: "emerald", label: "Emerald" },
  { key: "violet", label: "Violet" },
];
const linkClass = "rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors duration-150 hover:text-foreground";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/cartvibe-icon.svg`} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <script is:inline>
      // Apply the saved palette and mode before first paint. localStorage only; the site sets no cookies.
      (function () {
        var root = document.documentElement;
        var palette = null;
        var mode = null;
        try {
          palette = localStorage.getItem("cartvibe-site-palette");
          mode = localStorage.getItem("cartvibe-site-mode");
        } catch (e) {}
        if (["blue", "zinc", "indigo", "emerald", "violet"].indexOf(palette) > -1) root.dataset.palette = palette;
        var dark = mode === "dark" || (mode !== "light" && matchMedia("(prefers-color-scheme: dark)").matches);
        root.classList.toggle("dark", dark);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:border focus:border-border/70 focus:bg-card focus:px-4 focus:py-2"
      >Skip to content</a
    >
    <header class="sticky top-0 z-50 border-b border-border/70 bg-background" data-testid="site-header">
      <div class="page flex h-16 items-center gap-3">
        <a href={`${base}/`} class="flex items-center gap-2.5 font-semibold" aria-label="CartVibe home">
          <img class="shot-light size-8" src={`${base}/brand/icon-light.svg`} width="32" height="32" alt="" />
          <img class="shot-dark size-8" src={`${base}/brand/icon-dark.svg`} width="32" height="32" alt="" />
          <Wordmark />
        </a>
        <nav aria-label="Main" class="ml-6 hidden items-center gap-1 md:flex">
          {nav.map((item) => <a href={item.href} class={linkClass}>{item.label}</a>)}
          <a href={repo} class={linkClass}>GitHub</a>
        </nav>
        <div class="ml-auto flex items-center gap-2">
          <details class="relative" id="palette-menu">
            <summary
              class="inline-flex size-9 cursor-pointer items-center justify-center rounded-md border border-border bg-background hover:bg-accent"
              aria-label="Colour palette"
              data-testid="palette-menu"
            >
              <Icon name="palette" />
            </summary>
            <div class="absolute right-0 top-11 z-50 w-44 rounded-xl border border-border/70 bg-popover p-1.5 text-popover-foreground">
              <p class="cv-overline px-2 pb-1 pt-1.5">Colour palette</p>
              {
                palettes.map((p) => (
                  <button
                    type="button"
                    data-palette-option={p.key}
                    data-testid={`palette-${p.key}`}
                    aria-pressed="false"
                    class="flex h-9 w-full items-center gap-2.5 rounded-md px-2 text-sm hover:bg-accent aria-pressed:bg-accent aria-pressed:font-medium"
                  >
                    <span data-palette={p.key} class="size-4 rounded-full border border-border bg-primary" />
                    {p.label}
                  </button>
                ))
              }
            </div>
          </details>
          <button
            type="button"
            id="mode-toggle"
            data-testid="mode-toggle"
            class="inline-flex size-9 items-center justify-center rounded-md border border-border bg-background hover:bg-accent"
            aria-label="Switch between day and night"
          >
            <span class="icon-to-dark"><Icon name="moon" /></span>
            <span class="icon-to-light"><Icon name="sun" /></span>
          </button>
          <a
            href={`${repo}#quick-start`}
            class="hidden h-9 items-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground transition-colors duration-150 hover:bg-primary/80 sm:inline-flex"
            >Self-host it</a
          >
          <details class="relative md:hidden" id="mobile-menu">
            <summary
              class="inline-flex size-9 cursor-pointer items-center justify-center rounded-md border border-border bg-background hover:bg-accent"
              aria-label="Menu"
            >
              <Icon name="menu" />
            </summary>
            <div class="absolute right-0 top-11 z-50 w-56 rounded-xl border border-border/70 bg-popover p-1.5 text-popover-foreground">
              {nav.map((item) => <a href={item.href} class="block rounded-md px-3 py-2.5 text-sm font-medium hover:bg-accent">{item.label}</a>)}
              <a href={repo} class="block rounded-md px-3 py-2.5 text-sm font-medium hover:bg-accent">GitHub</a>
              <a
                href={`${repo}#quick-start`}
                class="mt-1 flex h-9 items-center justify-center rounded-md bg-primary px-3 text-sm font-medium text-primary-foreground hover:bg-primary/80"
                >Self-host it</a
              >
            </div>
          </details>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var store = function (key, value) {
          try {
            localStorage.setItem(key, value);
          } catch (e) {}
        };
        // Mode: Day or Night (the first visit follows the operating system).
        document.getElementById("mode-toggle").addEventListener("click", function () {
          var dark = !root.classList.contains("dark");
          root.classList.toggle("dark", dark);
          store("cartvibe-site-mode", dark ? "dark" : "light");
        });
        // Palette: Zinc (the default) plus the four accent palettes of the app.
        var options = document.querySelectorAll("[data-palette-option]");
        var paint = function () {
          var current = root.dataset.palette || "zinc";
          options.forEach(function (o) {
            o.setAttribute("aria-pressed", String(o.dataset.paletteOption === current));
          });
        };
        options.forEach(function (o) {
          o.addEventListener("click", function () {
            root.dataset.palette = o.dataset.paletteOption;
            store("cartvibe-site-palette", o.dataset.paletteOption);
            paint();
          });
        });
        paint();
        // Menus close after a choice and on Escape.
        var menus = [document.getElementById("mobile-menu"), document.getElementById("palette-menu")];
        document.getElementById("mobile-menu").addEventListener("click", function (e) {
          if (e.target.closest("a")) this.open = false;
        });
        document.addEventListener("keydown", function (e) {
          if (e.key !== "Escape") return;
          menus.forEach(function (m) {
            if (m.open) {
              m.open = false;
              m.querySelector("summary").focus();
            }
          });
        });
        document.addEventListener("click", function (e) {
          menus.forEach(function (m) {
            if (m.open && !m.contains(e.target)) m.open = false;
          });
        });
        // Final art dropped into public/art replaces a slot's wireframe; the 1px placeholder does not.
        document.querySelectorAll("[data-slot]").forEach(function (slot) {
          var img = slot.querySelector(".slot-art");
          var check = function () {
            if (img.naturalWidth > 8) slot.dataset.art = "true";
          };
          if (img.complete) check();
          img.addEventListener("load", check);
        });
      })();
    </script>
  </body>
</html>
