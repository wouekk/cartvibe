---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import Footer from "../components/Footer.astro";
import Wordmark from "../components/Wordmark.astro";
import { SOCIAL_IMAGE_ALT, SOCIAL_IMAGE_HEIGHT, SOCIAL_IMAGE_WIDTH, socialImageUrl } from "../lib/social-image";

interface Props {
  title: string;
  description: string;
  /** Structured data (schema.org JSON-LD) for this page; the home page sends its @graph (docs/site.md, "Search and sharing"). */
  jsonLd?: object;
}
const { title, description, jsonLd } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const repo = "https://github.com/wouekk/cartvibe";
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = await socialImageUrl(Astro.site);
// "<" is escaped so no string in the data can close the script element.
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, "\\u003c") : null;
const nav = [
  { href: `${base}/#features`, label: "Features" },
  { href: `${base}/#why`, label: "Why CartVibe" },
  { href: `${base}/#roadmap`, label: "Roadmap" },
  { href: `${base}/#faq`, label: "FAQ" },
];
// Same keys as PALETTES in desktop/src/theme/themes.ts; Zinc, the site's default, leads here (the app lists Blue first).
const palettes = [
  { key: "zinc", label: "Zinc" },
  { key: "blue", label: "Blue" },
  { key: "indigo", label: "Indigo" },
  { key: "emerald", label: "Emerald" },
  { key: "violet", label: "Violet" },
];
const linkClass = "whitespace-nowrap rounded-md px-3 py-2 text-sm font-medium text-muted-foreground transition-colors duration-150 hover:text-foreground aria-[current=location]:bg-accent aria-[current=location]:text-foreground";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/cartvibe-icon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://api.github.com" crossorigin />
    <meta property="og:site_name" content="CartVibe" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(SOCIAL_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(SOCIAL_IMAGE_HEIGHT)} />
    <meta property="og:image:alt" content={SOCIAL_IMAGE_ALT} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={SOCIAL_IMAGE_ALT} />
    {jsonLdText && <script type="application/ld+json" is:inline set:html={jsonLdText} />}
    <script is:inline>
      // Apply the saved palette and mode before first paint. localStorage only; the site sets no cookies.
      (function () {
        var root = document.documentElement;
        var palette = null;
        var mode = null;
        try {
          palette = localStorage.getItem("cartvibe-site-palette");
          mode = localStorage.getItem("cartvibe-site-mode");
        } catch (e) {}
        if (["blue", "zinc", "indigo", "emerald", "violet"].indexOf(palette) > -1) root.dataset.palette = palette;
        var dark = mode === "dark" || (mode !== "light" && matchMedia("(prefers-color-scheme: dark)").matches);
        root.classList.toggle("dark", dark);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <div class="bg-canvas" aria-hidden="true"><div class="bg-canvas__glow"></div><div class="bg-canvas__grid"></div></div>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60] focus:rounded-md focus:border focus:border-border/70 focus:bg-card focus:px-4 focus:py-2"
      >Skip to content</a
    >
    <header class="sticky top-0 z-50 border-b border-border/70 bg-background" data-testid="site-header">
      <div class="page flex h-16 items-center gap-3">
        <a href={`${base}/`} class="flex items-center gap-2.5 font-semibold" aria-label="CartVibe home">
          <img class="shot-light size-8" src={`${base}/brand/icon-light.svg`} width="32" height="32" alt="" />
          <img class="shot-dark size-8" src={`${base}/brand/icon-dark.svg`} width="32" height="32" alt="" />
          <Wordmark />
        </a>
        <nav aria-label="Main" class="ml-6 hidden items-center gap-1 xl:flex">
          {nav.map((item) => <a href={item.href} class={linkClass} data-spy>{item.label}</a>)}
          <a href={repo} class={`${linkClass} inline-flex items-center gap-1.5`} data-testid="nav-github"><Icon name="github" class="size-4" />GitHub</a>
        </nav>
        <div class="ml-auto flex items-center gap-2">
          <details class="relative" id="palette-menu">
            <summary
              class="inline-flex size-9 cursor-pointer items-center justify-center rounded-md border border-border bg-background hover:bg-accent"
              aria-label="Colour palette"
              data-testid="palette-menu"
            >
              <Icon name="palette" />
            </summary>
            <div class="absolute right-0 top-11 z-50 w-44 rounded-xl border border-border/70 bg-popover p-1.5 text-popover-foreground">
              <p class="cv-overline px-2 pb-1 pt-1.5">Colour palette</p>
              {
                palettes.map((p) => (
                  <button
                    type="button"
                    data-palette-option={p.key}
                    data-testid={`palette-${p.key}`}
                    aria-pressed="false"
                    class="flex h-9 w-full items-center gap-2.5 rounded-md px-2 text-sm hover:bg-accent aria-pressed:bg-accent aria-pressed:font-medium"
                  >
                    <span data-palette={p.key} class="size-4 rounded-full border border-border bg-primary" />
                    {p.label}
                  </button>
                ))
              }
            </div>
          </details>
          <button
            type="button"
            id="mode-toggle"
            data-testid="mode-toggle"
            class="inline-flex size-9 items-center justify-center rounded-md border border-border bg-background hover:bg-accent"
            aria-label="Switch between day and night"
          >
            <span class="icon-to-dark"><Icon name="moon" /></span>
            <span class="icon-to-light"><Icon name="sun" /></span>
          </button>
          <a
            href={`${base}/demo/`}
            class="hidden h-9 items-center whitespace-nowrap rounded-md border border-border bg-background px-4 text-sm font-medium transition-colors duration-150 hover:bg-accent md:inline-flex"
            data-testid="header-demo"
            >Demo</a
          >
          <a
            href={`${repo}#quick-start`}
            class="hidden h-9 items-center whitespace-nowrap rounded-md border border-border bg-background px-4 text-sm font-medium transition-colors duration-150 hover:bg-accent md:inline-flex"
            data-testid="header-selfhost"
            >Self-host it</a
          >
          <a
            href={`${base}/#iphone`}
            class="hidden h-9 items-center whitespace-nowrap rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground transition-colors duration-150 hover:bg-primary/80 sm:inline-flex"
            data-testid="header-iphone"
            >iPhone app</a
          >
          <details class="relative xl:hidden" id="mobile-menu">
            <summary
              class="inline-flex size-9 cursor-pointer items-center justify-center rounded-md border border-border bg-background hover:bg-accent"
              aria-label="Menu"
            >
              <Icon name="menu" />
            </summary>
            <div class="absolute right-0 top-11 z-50 w-56 rounded-xl border border-border/70 bg-popover p-1.5 text-popover-foreground">
              {nav.map((item) => <a href={item.href} class="block rounded-md px-3 py-2.5 text-sm font-medium hover:bg-accent aria-[current=location]:bg-accent" data-spy>{item.label}</a>)}
              <a href={repo} class="flex items-center gap-2 rounded-md px-3 py-2.5 text-sm font-medium hover:bg-accent"><Icon name="github" class="size-4" />GitHub</a>
              <a
                href={`${base}/#iphone`}
                class="mt-1 flex h-9 items-center justify-center rounded-md bg-primary px-3 text-sm font-medium text-primary-foreground hover:bg-primary/80"
                >iPhone app</a
              >
              <a
                href={`${base}/demo/`}
                class="mt-1 flex h-9 items-center justify-center rounded-md border border-border bg-background px-3 text-sm font-medium hover:bg-accent"
                >Demo</a
              >
              <a
                href={`${repo}#quick-start`}
                class="mt-1 flex h-9 items-center justify-center rounded-md border border-border bg-background px-3 text-sm font-medium hover:bg-accent"
                >Self-host it</a
              >
            </div>
          </details>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script>
      // Background parallax: the grid glides up at 0.18x the scroll speed (wrapping every 48px, so it never runs out) and the
      // glow drifts along a sine. Only transforms change on scroll; the mask sits on the static parent (global.css).
      const grid = document.querySelector<HTMLElement>(".bg-canvas__grid");
      const glow = document.querySelector<HTMLElement>(".bg-canvas__glow");
      if (grid && glow) {
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
        let queued = false;
        const apply = () => {
          queued = false;
          if (reduce.matches) {
            grid.style.transform = "";
            glow.style.transform = "";
            return;
          }
          const y = -(window.scrollY * 0.18) % 48;
          grid.style.transform = `translate3d(0, ${y}px, 0)`;
          glow.style.transform = `translate3d(0, ${Math.sin(window.scrollY * 0.0015) * 40}px, 0)`;
        };
        window.addEventListener(
          "scroll",
          () => {
            if (!queued) {
              queued = true;
              requestAnimationFrame(apply);
            }
          },
          { passive: true },
        );
        reduce.addEventListener("change", apply);
        apply();
      }
    </script>

    <script>
      // The nav link of the section in view is marked (aria-current="location"): scroll down to the FAQ and "FAQ" lights up.
      const items = Array.from(document.querySelectorAll<HTMLAnchorElement>("a[data-spy]"))
        .map((a) => {
          const url = new URL(a.href);
          return { a, id: url.hash.slice(1), path: url.pathname.replace(/\/$/, "") };
        })
        .filter((i) => i.id && i.path === location.pathname.replace(/\/$/, ""));
      if (items.length > 0) {
        const ids = [...new Set(items.map((i) => i.id))];
        // Features is two elements, a scroll track on large screens and a stack on small ones; the hidden one has no box.
        const find = (id: string) =>
          [id, `${id}-stacked`].map((x) => document.getElementById(x)).find((el) => el && el.getClientRects().length > 0) ?? null;
        const header = document.querySelector<HTMLElement>('[data-testid="site-header"]');
        let queued = false;
        const update = () => {
          queued = false;
          const line = (header?.getBoundingClientRect().height ?? 64) + window.innerHeight * 0.2;
          const sections = ids.map((id) => ({ id, el: find(id) })).filter((s): s is { id: string; el: HTMLElement } => s.el !== null);
          let current = "";
          for (const s of sections) if (s.el.getBoundingClientRect().top <= line) current = s.id;
          const last = sections[sections.length - 1];
          // Below the last section (the closing call to action, the footer) nothing is marked.
          if (last && current === last.id && last.el.getBoundingClientRect().bottom < line) current = "";
          for (const i of items) {
            if (i.id === current) i.a.setAttribute("aria-current", "location");
            else i.a.removeAttribute("aria-current");
          }
        };
        const queue = () => {
          if (!queued) {
            queued = true;
            requestAnimationFrame(update);
          }
        };
        window.addEventListener("scroll", queue, { passive: true });
        window.addEventListener("resize", queue);
        update();
      }
    </script>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var store = function (key, value) {
          try {
            localStorage.setItem(key, value);
          } catch (e) {}
        };
        // Mode: Day or Night (the first visit follows the operating system).
        document.getElementById("mode-toggle").addEventListener("click", function () {
          var dark = !root.classList.contains("dark");
          root.classList.toggle("dark", dark);
          store("cartvibe-site-mode", dark ? "dark" : "light");
        });
        // Palette: Zinc (the default) plus the four accent palettes of the app.
        var options = document.querySelectorAll("[data-palette-option]");
        var paint = function () {
          var current = root.dataset.palette || "zinc";
          options.forEach(function (o) {
            o.setAttribute("aria-pressed", String(o.dataset.paletteOption === current));
          });
        };
        options.forEach(function (o) {
          o.addEventListener("click", function () {
            root.dataset.palette = o.dataset.paletteOption;
            store("cartvibe-site-palette", o.dataset.paletteOption);
            paint();
          });
        });
        paint();
        // Menus close after a choice and on Escape.
        var menus = [document.getElementById("mobile-menu"), document.getElementById("palette-menu")];
        document.getElementById("mobile-menu").addEventListener("click", function (e) {
          if (e.target.closest("a")) this.open = false;
        });
        document.addEventListener("keydown", function (e) {
          if (e.key !== "Escape") return;
          menus.forEach(function (m) {
            if (m.open) {
              m.open = false;
              m.querySelector("summary").focus();
            }
          });
        });
        document.addEventListener("click", function (e) {
          menus.forEach(function (m) {
            if (m.open && !m.contains(e.target)) m.open = false;
          });
        });
      })();
    </script>
  </body>
</html>
