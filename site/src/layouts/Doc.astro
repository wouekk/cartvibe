---
// A page of plain text (privacy, support): the site's header and footer around one narrow column (`.doc` in global.css).
import Base from "./Base.astro";

interface Props {
  title: string;
  description: string;
  overline: string;
  heading: string;
  updated?: string;
}
const { title, description, overline, heading, updated } = Astro.props;
---

<Base title={title} description={description}>
  <article class="page max-w-3xl py-14 sm:py-20" data-testid="doc">
    <p class="cv-overline">{overline}</p>
    <h1 class="mt-2 text-balance text-3xl font-semibold tracking-tight sm:text-4xl">{heading}</h1>
    {updated && <p class="mt-3 text-[13px] text-muted-foreground" data-testid="doc-updated">{updated}</p>}
    <div class="doc mt-8">
      <slot />
    </div>
  </article>
</Base>
