---
import { getImage } from "astro:assets";
// A desktop and/or phone screenshot of the real app, in a day and a night version (the page theme picks one).
// Files live in src/assets/shots as <name>-<desktop|phone>-<light|dark>.webp (see tools/make-images.mjs). Each is served as a
// srcset cut from that file at build time, so a phone is not sent the 2000 px desktop picture.
interface Props {
  /** The `sizes` of the desktop picture: how wide it is shown. */
  sizes?: string;
  desktop?: string;
  phone?: string;
  alt: string;
  eager?: boolean;
  /** Replaces the default `max-w-[44rem]` of the frame. */
  class?: string;
}
const { desktop, phone, alt, eager = false, class: cls = "max-w-[44rem]", sizes = "(min-width: 768px) 704px, 100vw" } = Astro.props;
const phoneSizes = "(min-width: 640px) 256px, 240px";

const images = import.meta.glob<{ default: ImageMetadata }>("../assets/shots/*.webp", { eager: true });
const pick = (name: string, vp: string, mode: string) => {
  const found = images[`../assets/shots/${name}-${vp}-${mode}.webp`];
  if (!found) throw new Error(`Missing screenshot ${name}-${vp}-${mode}.webp`);
  return found.default;
};
const loading = eager ? "eager" : "lazy";
// The same picture at several widths; the browser takes the smallest that is still sharp on its screen.
const cut = async (meta: ImageMetadata, widths: number[]) => {
  const w = widths.filter((x) => x < meta.width);
  const r = await getImage({ src: meta, widths: [...w, meta.width], format: "webp", quality: 78 });
  return { src: r.src, srcset: r.srcSet.attribute };
};
const desktopWidths = [640, 960, 1400];
const phoneWidths = [260, 390];
---

<figure class:list={["relative mx-auto w-full min-w-0", cls]} data-shots>
  {
    desktop && (
      <div
        class:list={["overflow-hidden rounded-xl border border-border/70 bg-card", phone ? "hidden sm:mr-16 sm:block" : "overflow-x-auto"]}
        role={phone ? undefined : "region"}
        aria-label={phone ? undefined : "Screenshot, scrolls sideways on narrow screens"}
        tabindex={phone ? undefined : 0}
      >
        {(["light", "dark"] as const).map(async (mode) => {
          const img = pick(desktop, "desktop", mode);
          const set = await cut(img, desktopWidths);
          return (
            <img
              class={`shot-${mode} h-auto w-full${phone ? "" : " min-w-[34rem]"}`}
              src={set.src}
              srcset={set.srcset}
              sizes={sizes}
              fetchpriority={eager && mode === "light" ? "high" : undefined}
              width={img.width}
              height={img.height}
              alt={alt}
              loading={loading}
              decoding="async"
            />
          );
        })}
      </div>
    )
  }
  {
    phone && (
      <div
        class:list={[
          "overflow-hidden rounded-[1.75rem] border-[5px] border-foreground/90 bg-card",
          desktop
            ? "mx-auto w-[15rem] sm:absolute sm:-bottom-6 sm:right-0 sm:w-[26%] sm:min-w-[5.5rem]"
            : "mx-auto w-[15rem] sm:w-[16rem]",
        ]}
      >
        {(["light", "dark"] as const).map(async (mode) => {
          const img = pick(phone, "phone", mode);
          const set = await cut(img, phoneWidths);
          return (
            <img
              class={`shot-${mode} h-auto w-full`}
              src={set.src}
              srcset={set.srcset}
              sizes={phoneSizes}
              width={img.width}
              height={img.height}
              alt={desktop ? "The same screen on a phone" : alt}
              loading={loading}
              decoding="async"
            />
          );
        })}
      </div>
    )
  }
</figure>
