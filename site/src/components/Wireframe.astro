---
// CSS wireframes of the CartVibe UI states. Illustration only: every number is sample data.
import Icon from "./Icon.astro";

interface Props {
  kind: "hero" | "list" | "scan" | "labels" | "overview";
}
const { kind } = Astro.props;

const listItems = [
  { name: "Spinach", amount: "" },
  { name: "Pasta", amount: "1 kg" },
  { name: "Coffee beans", amount: "" },
  { name: "Bread", amount: "" },
  { name: "Pears", amount: "6 pcs" },
  { name: "Greek yoghurt", amount: "" },
];
const scanLines = [
  ["Bananas 1.2 kg", "2.39"],
  ["Pears", "3.49"],
  ["Pumpkin", "2.99"],
  ["Whole milk 1 L", "1.19"],
  ["Greek yoghurt", "1.79"],
  ["Sourdough loaf", "3.60"],
  ["Chocolate bar", "1.99"],
  ["Cola 6-pack", "5.40"],
  ["Dish soap", "2.19"],
];
const labelRows = [
  { name: "Pears", cat: "Fresh Produce", health: "Healthy", dot: "bg-nutri-a", text: "text-success-text", plan: "Planned" },
  { name: "Greek yoghurt", cat: "Dairy", health: "Healthy", dot: "bg-nutri-a", text: "text-success-text", plan: "Planned" },
  { name: "Sourdough loaf", cat: "Bakery", health: "Medium", dot: "bg-nutri-c", text: "text-muted-foreground", plan: "Planned" },
  { name: "Cola 6-pack", cat: "Drinks", health: "Unhealthy", dot: "bg-nutri-e", text: "text-warning-text", plan: "Not on the list" },
];
const categories = [
  { name: "Groceries", amount: "148.20", width: 100, bar: "bg-chart-1" },
  { name: "Transport", amount: "64.20", width: 43, bar: "bg-chart-2" },
  { name: "Travel", amount: "52.00", width: 35, bar: "bg-chart-3" },
  { name: "Eating out", amount: "41.00", width: 28, bar: "bg-chart-4" },
  { name: "Leisure", amount: "25.50", width: 17, bar: "bg-chart-5" },
  { name: "Bills", amount: "21.55", width: 15, bar: "bg-muted-foreground" },
];
---

{
  kind === "hero" && (
    <div class="grid h-full gap-3 p-4 sm:grid-cols-[1.4fr_1fr] sm:p-5">
      <div class="flex min-w-0 flex-col gap-3">
        <p class="cv-overline">Dashboard · this month</p>
        <div class="grid grid-cols-3 gap-2">
          <div class="rounded-lg border border-border/70 bg-muted/30 p-3">
            <p class="text-xs font-medium text-muted-foreground">Spent</p>
            <p class="mt-1 text-xl font-bold tabular-nums sm:text-2xl">352.45</p>
          </div>
          <div class="rounded-lg border border-border/70 bg-muted/30 p-3">
            <p class="text-xs font-medium text-muted-foreground">Receipts</p>
            <p class="mt-1 text-xl font-bold tabular-nums sm:text-2xl">12</p>
          </div>
          <div class="rounded-lg border border-border/70 bg-muted/30 p-3">
            <p class="text-xs font-medium text-muted-foreground">To buy</p>
            <p class="mt-1 text-xl font-bold tabular-nums sm:text-2xl">10</p>
          </div>
        </div>
        <div class="rounded-lg border border-border/70 p-3">
          <div class="flex items-center justify-between text-xs">
            <span class="font-medium text-muted-foreground">Monthly goal</span>
            <span class="tabular-nums text-muted-foreground">54% of 650.00</span>
          </div>
          <div class="mt-2 h-2 rounded-full bg-muted">
            <div class="h-2 rounded-full bg-primary" style="width: 54%" />
          </div>
        </div>
        <div class="flex flex-1 items-end gap-2 rounded-lg border border-border/70 p-3" aria-hidden="true">
          {[8, 26, 40, 74, 54, 72].map((h) => (
            <div class="flex-1 rounded-sm bg-muted" style={`height: ${h}px`} />
          ))}
          <div class="flex-1 rounded-sm bg-primary" style="height: 72px" />
        </div>
      </div>
      <div class="hidden min-w-0 flex-col rounded-lg border border-border/70 sm:flex">
        <div class="border-b border-border/60 px-3 py-2.5 text-sm font-semibold">Weekly groceries</div>
        {listItems.slice(0, 5).map((item) => (
          <div class="flex min-h-11 items-center gap-2 border-b border-border/40 px-3 text-sm last:border-b-0">
            <span class="size-4 shrink-0 rounded-full border border-border" />
            <span class="min-w-0 flex-1 truncate">{item.name}</span>
            {item.amount && <span class="rounded-md bg-muted px-1.5 text-xs tabular-nums">{item.amount}</span>}
          </div>
        ))}
      </div>
    </div>
  )
}

{
  kind === "list" && (
    <div class="flex h-full items-center justify-center gap-6 p-4 sm:p-6">
      <div class="w-full max-w-[19rem] rounded-xl border border-border/70 bg-card">
        <div class="flex min-h-14 items-center justify-between border-b border-border/60 px-4">
          <div>
            <p class="text-sm font-semibold">Weekly groceries</p>
            <p class="text-xs text-muted-foreground">7 to buy</p>
          </div>
          <span class="inline-flex items-center gap-1.5 text-xs font-medium text-success-text">
            <span class="live-dot size-2 animate-pulse rounded-full bg-success-text" /> Live
          </span>
        </div>
        <div class="stagger">
          {listItems.map((item, i) => (
            <div style={`--i:${i}`} class="flex min-h-11 items-center gap-3 border-b border-border/40 px-4 text-sm last:border-b-0">
              {i < 1 ? (
                <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-primary text-primary-foreground">
                  <Icon name="check" class="size-3" />
                </span>
              ) : (
                <span class="size-5 shrink-0 rounded-full border border-border" />
              )}
              <span class:list={["min-w-0 flex-1 truncate", i < 1 && "text-muted-foreground line-through"]}>{item.name}</span>
              {item.amount && <span class="rounded-md bg-muted px-2 py-0.5 text-xs font-medium tabular-nums">{item.amount}</span>}
            </div>
          ))}
        </div>
        <div class="flex h-9 items-center gap-2 border-t border-border/60 px-4 text-xs text-muted-foreground">
          <Icon name="refresh" class="size-3.5" /> Added from another phone, just now
        </div>
      </div>
      <div class="hidden w-40 flex-col gap-3 sm:flex">
        <p class="cv-overline">At 360 px</p>
        <p class="text-sm text-muted-foreground">Big tap targets, one hand, no pinch-zoom. Cross things off as you walk.</p>
        <p class="text-sm text-muted-foreground">Every change shows on the other phones without a refresh.</p>
      </div>
    </div>
  )
}

{
  kind === "scan" && (
    <div class="grid h-full gap-4 p-4 sm:grid-cols-[0.8fr_1.2fr] sm:p-6">
      <div class="hidden rounded-lg border border-border/70 bg-muted/30 p-4 sm:block" aria-hidden="true">
        <div class="mx-auto h-3 w-24 rounded-sm bg-muted" />
        <div class="mt-4 space-y-2.5">
          {Array.from({ length: 9 }).map((_, i) => (
            <div class="flex items-center justify-between gap-3">
              <div class="h-2 rounded-sm bg-muted" style={`width: ${40 + ((i * 17) % 35)}%`} />
              <div class="h-2 w-8 rounded-sm bg-muted" />
            </div>
          ))}
        </div>
        <div class="mt-4 flex items-center justify-between border-t border-border/60 pt-3">
          <div class="h-2.5 w-10 rounded-sm bg-muted" />
          <div class="h-2.5 w-12 rounded-sm bg-primary" />
        </div>
      </div>
      <div class="flex min-w-0 flex-col rounded-lg border border-border/70 bg-card">
        <div class="flex min-h-11 items-center justify-between border-b border-border/60 px-3">
          <span class="cv-overline">Lines read from the receipt</span>
        </div>
        <div class="stagger flex-1">
          {scanLines.map(([name, price], i) => (
            <div style={`--i:${i}`} class="flex min-h-8 items-center justify-between gap-3 border-b border-border/40 px-3 text-sm">
              <span class="min-w-0 truncate">{name}</span>
              <span class="font-medium tabular-nums">{price}</span>
            </div>
          ))}
        </div>
        <div class="flex items-center justify-between border-t border-border/60 px-3 py-2.5">
          <span class="inline-flex items-center gap-1.5 text-xs font-medium text-success-text">
            <Icon name="check" class="size-3.5" /> Lines add up to the total
          </span>
          <span class="text-base font-bold tabular-nums">25.03</span>
        </div>
      </div>
    </div>
  )
}

{
  kind === "labels" && (
    <div class="flex h-full flex-col gap-3 p-4 sm:p-6">
      <div class="stagger rounded-lg border border-border/70 bg-card">
        {labelRows.map((row, i) => (
          <div
            style={`--i:${i}`}
            class="flex min-h-12 flex-wrap items-center gap-x-3 gap-y-1 border-b border-border/40 px-3 py-1.5 text-sm last:border-b-0"
          >
            <span class="min-w-[6.5rem] flex-1 truncate font-medium">{row.name}</span>
            <span class="rounded-md bg-muted px-2 py-0.5 text-xs">{row.cat}</span>
            <span class={`inline-flex items-center gap-1.5 text-xs font-medium ${row.text}`}>
              <span class={`size-2 rounded-full ${row.dot}`} /> {row.health}
            </span>
            <span class:list={["w-24 text-right text-xs", row.plan === "Planned" ? "text-muted-foreground" : "font-medium text-warning-text"]}>
              {row.plan}
            </span>
          </div>
        ))}
      </div>
      <div class="rounded-lg border border-dashed border-border/70 bg-muted/30 p-3">
        <p class="cv-overline">If the AI is offline</p>
        <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
          <span class="min-w-[6.5rem] flex-1 truncate font-medium">Oat milk</span>
          <span class="rounded-md bg-muted px-2 py-0.5 text-xs text-muted-foreground">Uncategorized</span>
          <span class="inline-flex items-center gap-1.5 text-xs text-muted-foreground">
            <span class="size-2 rounded-full bg-muted-foreground/50" /> Unknown
          </span>
          <span class="w-24 text-right text-xs text-muted-foreground">Planned</span>
        </div>
        <p class="mt-2 text-xs text-muted-foreground">Nothing blocks. Labels are filled in on a later retry, and the AI never assigns your tags.</p>
      </div>
    </div>
  )
}

{
  kind === "overview" && (
    <div class="grid h-full gap-3 p-4 sm:grid-cols-[1fr_1.1fr] sm:p-6">
      <div class="flex flex-col gap-3">
        <div class="rounded-lg border border-border/70 bg-muted/30 p-4">
          <p class="text-xs font-medium text-muted-foreground">Spent this month</p>
          <p class="mt-1 text-3xl font-bold tabular-nums">352.45</p>
          <div class="mt-3 h-2 rounded-full bg-muted">
            <div class="h-2 rounded-full bg-primary" style="width: 54%" />
          </div>
          <p class="mt-2 flex justify-between text-xs tabular-nums text-muted-foreground">
            <span>Goal 650.00</span><span>297.55 left</span>
          </p>
        </div>
        <div class="rounded-lg border border-border/70 p-3 text-sm">
          <p class="cv-overline">Paid by</p>
          <p class="mt-1 font-medium">You</p>
          <p class="text-xs text-muted-foreground">Filled in from the signed-in family member. Nobody splits bills.</p>
        </div>
      </div>
      <div class="stagger flex flex-col rounded-lg border border-border/70">
        {categories.map((c, i) => (
          <div style={`--i:${i}`} class="border-b border-border/40 px-3 py-2 last:border-b-0">
            <div class="flex items-center justify-between text-sm">
              <span>{c.name}</span>
              <span class="font-medium tabular-nums">{c.amount}</span>
            </div>
            <div class="mt-1.5 h-1.5 rounded-full bg-muted">
              <div class={`h-1.5 rounded-full ${c.bar}`} style={`width: ${c.width}%`} />
            </div>
          </div>
        ))}
      </div>
    </div>
  )
}
