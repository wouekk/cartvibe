---
// The releases of CHANGELOG.md as a list, one line per release (version, date, its milestone), read at build time (no
// request in the browser). The latest four are shown; the older ones sit behind a "show older" row.
import Icon from "./Icon.astro";
import { formatDate, parseChangelog } from "../lib/changelog.mjs";
import changelog from "../../../CHANGELOG.md?raw";

const SHOWN = 4;
const releases = parseChangelog(changelog, { releases: 100, highlights: 3 }).map((r) => ({
  ...r,
  line: r.summary || r.highlights.join(" · "),
}));
const recent = releases.slice(0, SHOWN);
const older = releases.slice(SHOWN);
const url = "https://github.com/wouekk/cartvibe/blob/main/CHANGELOG.md";
const link = "inline-flex h-9 items-center gap-1.5 rounded-md border border-border bg-background px-4 text-sm font-medium transition-colors duration-150 hover:bg-accent active:scale-[0.98]";
---

<section id="changelog" aria-labelledby="changelog-title" data-testid="changelog-section" class="min-w-0">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="cv-overline">CHANGELOG</p>
      <h3 id="changelog-title" class="mt-2 text-xl font-semibold tracking-tight">What changed, release by release</h3>
    </div>
    <a href={url} class={link} rel="noopener noreferrer" data-testid="changelog-full">
      Full changelog on GitHub <Icon name="external" class="size-3.5" />
    </a>
  </div>

  <div class="mt-5 overflow-hidden rounded-xl border border-border/70 bg-card">
    <ol class="divide-y divide-border/60" data-testid="changelog-recent">
      {recent.map((r) => (
        <li class="flex flex-col gap-0.5 px-4 py-3 sm:flex-row sm:items-baseline sm:gap-5" data-testid="changelog-release">
          <span class="flex shrink-0 items-baseline gap-3 sm:w-48">
            <h4 class="text-[15px] font-semibold tabular-nums">{r.version}</h4>
            <time class="text-xs tabular-nums text-muted-foreground" datetime={r.date}>{formatDate(r.date)}</time>
          </span>
          {r.line && <p class="min-w-0 text-[13px] text-muted-foreground sm:truncate" title={r.line} data-testid="changelog-summary">{r.line}</p>}
        </li>
      ))}
    </ol>
    {older.length > 0 && (
      <details class="border-t border-border/60" data-testid="changelog-more">
        <summary class="flex h-11 cursor-pointer items-center justify-between gap-3 px-4 text-[13px] font-medium text-muted-foreground transition-colors duration-150 hover:bg-accent hover:text-foreground">
          <span>Older versions <span class="tabular-nums">({older.length})</span></span>
          <Icon name="chevron" class="faq-chevron size-4 shrink-0" />
        </summary>
        <ol class="divide-y divide-border/60 border-t border-border/60" data-testid="changelog-older">
          {older.map((r) => (
            <li class="flex flex-col gap-0.5 px-4 py-3 sm:flex-row sm:items-baseline sm:gap-5" data-testid="changelog-release">
              <span class="flex shrink-0 items-baseline gap-3 sm:w-48">
                <h4 class="text-[15px] font-semibold tabular-nums">{r.version}</h4>
                <time class="text-xs tabular-nums text-muted-foreground" datetime={r.date}>{formatDate(r.date)}</time>
              </span>
              {r.line && <p class="min-w-0 text-[13px] text-muted-foreground sm:truncate" title={r.line}>{r.line}</p>}
            </li>
          ))}
        </ol>
      </details>
    )}
  </div>
</section>
