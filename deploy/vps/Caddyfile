# Caddy terminates TLS for CartVibe and gets the certificate from Let's Encrypt on its own.
# It sets X-Forwarded-For and X-Forwarded-Proto, which the image's nginx trusts from private networks
# (the client IP for rate limits, and HSTS).
{$CARTVIBE_DOMAIN} {
	encode zstd gzip
	reverse_proxy cartvibe:80 {
		# The shopping-list live sync is a long-lived SSE stream.
		flush_interval -1
	}
}
